# ~/.aliases — Shared aliases for all machines.
# Machine-local overrides live in ~/.aliases.local (not synced).
# Note: mlbt uses docker here; ~/.aliases.local overrides with podman on Distrobox/Fedora.

# --- ls ---
alias sl='lsd'
alias ls='lsd -h'
alias lls='lsd -lah'
alias ls-old='/bin/ls -h --color'

# --- Editors ---
alias emacs='emacs -nw'
alias vim='nvim'

# --- System ---
alias python='python3'
alias htop='sudo htop'
alias sudo='sudo --preserve-env=HOME '

# --- Apps ---
alias dosbox='dosbox --conf "./dosbox-staging.conf"'
alias remind='remind ~/.reminders'
alias ws='wolframscript'
alias pb='pb -c'
alias ytdl='yt-dlp -f "bestvideo[ext=mp4]+bestaudio[ext=m4a]/mp4"'

# --- Network / web ---
alias curl='curl -w "\n"'
alias weather='curl "wttr.in/Los_Angeles"'
alias whatsmyip='curl ifconfig.me/ip'
alias bbs='ssh -t circumlunar bbs'
alias mlb-dlp='yt-dlp --username $MLB_USERNAME --password $MLB_PASSWORD'

# --- Docker ---
alias dcp='docker compose pull && docker compose up -d --remove-orphans && docker image prune -f'
#alias mlbt='docker run -it --rm --name mlbt ghcr.io/mlb-rs/mlbt'
#alias mlbtg='docker run -it --rm --name mlbtg ghcr.io/agiacalone/mlbtg'
alias mlbtg='docker run -it --rm --pull=always --name mlbtg -e XDG_CONFIG_HOME=/config -v ~/.config/mlbt:/config/mlbt:Z ghcr.io/agiacalone/mlbtg'
alias mlbtg-p='host-spawn podman run -it --rm --pull=always --name mlbtg -e XDG_CONFIG_HOME=/config -v ~/.config/mlbt:/config/mlbt:Z ghcr.io/agiacalone/mlbtg'

# --- Claude Code ---
alias claude-pro='claude'         # uses OAuth/keychain (claude.ai Pro)
alias claude-api='claude --bare'  # uses API key from private config, skips keychain

# --- Machine-local aliases (not synced with dotfiles) ---
[ -f ~/.aliases.local ] && source ~/.aliases.local

