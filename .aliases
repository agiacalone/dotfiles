# My custom aliases
alias lah='ls -lah'
alias sl='ls'
alias ls='ls -hG --color'
alias lls='ls -lahG --color'
alias python='python3'
alias dosbox='dosbox --conf "./dosbox-staging.conf"'
alias slrn='slrn -h news.eternal-september.org -f ~/.jnewsrc-es -i ~/.slrnrc'
alias remind='remind ~/.reminders'
alias emacs='emacs -nw'
alias vim='nvim'
alias htop='sudo htop'
alias ytdl='yt-dlp -f "bestvideo[ext=mp4]+bestaudio[ext=m4a]/mp4"'
alias sudo='sudo --preserve-env=HOME '
alias ws='wolframscript'
alias pb='pb -c'
alias bbs='ssh -t circumlunar bbs'
alias dcp='docker compose pull && docker compose up -d --remove-orphans && docker image prune -f'
alias lsh='ls -lah'
alias curl='curl -w "\n"'
alias weather='curl "wttr.in/Los_Angeles"'
alias whatsmyip='curl ifconfig.me/ip'
alias mlbt='docker run -it --rm --name mlbt ghcr.io/mlb-rs/mlbt'

# Machine-local aliases (not synced with dotfiles)
[ -f ~/.aliases.local ] && source ~/.aliases.local
