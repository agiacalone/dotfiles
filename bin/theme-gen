#!/usr/bin/env bash
# theme-gen — turn a palette (themes/<name>.theme) into downstream artifacts.
# Subcommands:
#   theme-gen tmux <name>             -> tmux status-bar conf (stdout)
#   theme-gen konsole-scheme <name>   -> Konsole .colorscheme INI (stdout)
#   theme-gen konsole-profile <name>  -> Konsole .profile INI (stdout)
#   theme-gen iterm <name> [name...]  -> iTerm2 Dynamic Profile JSON (stdout, all themes)
#   theme-gen itermcolors <name>      -> iTerm2 .itermcolors plist (stdout)
set -u
BIN_DIR="$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")" && pwd)"
THEME_ROOT="${THEME_ROOT:-$(cd "$BIN_DIR/../themes" 2>/dev/null && pwd)}"
. "$THEME_ROOT/lib/palette.sh"
THEME_FONT="JetBrainsMono Nerd Font Mono"; THEME_FONT_SIZE=13
[ -r "$THEME_ROOT/theme.conf" ] && . "$THEME_ROOT/theme.conf"

hex2rgb() { local h="${1#\#}"; printf '%d %d %d' "0x${h:0:2}" "0x${h:2:2}" "0x${h:4:2}"; }

_load() { declare -gA PAL=(); palette_load "$(palette_path "$1")" || { echo "theme-gen: unknown theme: $1" >&2; exit 1; }; }

# JSON sRGB color object (components 0..1)
_itcolor() {
  local r g b; read -r r g b <<<"$(hex2rgb "$1")"
  awk -v r="$r" -v g="$g" -v b="$b" 'BEGIN{printf "{\"Color Space\":\"sRGB\",\"Red Component\":%.6f,\"Green Component\":%.6f,\"Blue Component\":%.6f}", r/255,g/255,b/255}'
}
# plist color dict
_plcolor() {
  local r g b; read -r r g b <<<"$(hex2rgb "$1")"
  awk -v r="$r" -v g="$g" -v b="$b" 'BEGIN{printf "<dict><key>Color Space</key><string>sRGB</string><key>Red Component</key><real>%.6f</real><key>Green Component</key><real>%.6f</real><key>Blue Component</key><real>%.6f</real></dict>", r/255,g/255,b/255}'
}

gen_tmux() {
  _load "$1"
  local ak="${PAL[tmux_accent]:-color4}" acc; acc="${PAL[$ak]}"
  cat <<EOF
# Generated by theme-gen from themes/$1.theme — do not edit by hand.
set -g status-style "bg=${PAL[bg]},fg=${PAL[fg]}"
set -g status-left-style "bg=$acc,fg=${PAL[bg]}"
set -g status-right-style "bg=${PAL[color8]},fg=${PAL[fg]}"
set -g window-status-current-style "fg=$acc,bold"
set -g window-status-style "fg=${PAL[color7]}"
set -g pane-active-border-style "fg=$acc"
set -g pane-border-style "fg=${PAL[color8]}"
set -g message-style "bg=$acc,fg=${PAL[bg]}"
set -g mode-style "bg=$acc,fg=${PAL[bg]}"
# Paint pane backgrounds as cells (not via emulator OSC) so the theme survives
# mosh + ShadowTerm/SwiftTerm, which sync screen cells but drop palette OSC.
set -g window-style "fg=${PAL[fg]},bg=${PAL[bg]}"
set -g window-active-style "fg=${PAL[fg]},bg=${PAL[bg]}"
EOF
}

gen_konsole_scheme() {
  _load "$1"; local i r g b
  _kc() { read -r r g b <<<"$(hex2rgb "$1")"; printf '[%s]\nColor=%s,%s,%s\n\n' "$2" "$r" "$g" "$b"; }
  _kc "${PAL[bg]}" Background
  _kc "${PAL[bg]}" BackgroundIntense
  _kc "${PAL[fg]}" Foreground
  _kc "${PAL[fg]}" ForegroundIntense
  for i in 0 1 2 3 4 5 6 7; do _kc "${PAL[color$i]}" "Color$i"; done
  for i in 0 1 2 3 4 5 6 7; do _kc "${PAL[color$((i+8))]}" "Color${i}Intense"; done
  printf '[General]\nDescription=%s\nOpacity=1\n' "$1"
}

gen_konsole_profile() {
  _load "$1"
  cat <<EOF
[Appearance]
ColorScheme=$1
Font=$THEME_FONT,$THEME_FONT_SIZE,-1,5,50,0,0,0,0,0

[General]
Name=Theme $1
Parent=FALLBACK/
EOF
}

gen_iterm() {
  local names=("$@") n i first=1
  { printf '{"Profiles":['
    for n in "${names[@]}"; do
      _load "$n"
      [ $first -eq 1 ] || printf ','; first=0
      printf '{"Name":"Theme %s","Guid":"readest-%s",' "$n" "$n"
      printf '"Normal Font":"%s %s","Use Non-ASCII Font":false,' "$THEME_FONT" "$THEME_FONT_SIZE"
      for i in $(seq 0 15); do printf '"Ansi %s Color":%s,' "$i" "$(_itcolor "${PAL[color$i]}")"; done
      printf '"Background Color":%s,' "$(_itcolor "${PAL[bg]}")"
      printf '"Foreground Color":%s,' "$(_itcolor "${PAL[fg]}")"
      printf '"Cursor Color":%s,' "$(_itcolor "${PAL[cursor]}")"
      printf '"Selection Color":%s}' "$(_itcolor "${PAL[selection]}")"
    done
    printf ']}'
  } | jq .
}

gen_itermcolors() {
  _load "$1"; local i
  printf '<?xml version="1.0" encoding="UTF-8"?>\n'
  printf '<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">\n'
  printf '<plist version="1.0"><dict>\n'
  for i in $(seq 0 15); do printf '<key>Ansi %s Color</key>%s\n' "$i" "$(_plcolor "${PAL[color$i]}")"; done
  printf '<key>Background Color</key>%s\n' "$(_plcolor "${PAL[bg]}")"
  printf '<key>Foreground Color</key>%s\n' "$(_plcolor "${PAL[fg]}")"
  printf '<key>Cursor Color</key>%s\n' "$(_plcolor "${PAL[cursor]}")"
  printf '<key>Selection Color</key>%s\n' "$(_plcolor "${PAL[selection]}")"
  printf '</dict></plist>\n'
}

cmd="${1:-}"; shift || true
case "$cmd" in
  tmux)            gen_tmux "$1" ;;
  konsole-scheme)  gen_konsole_scheme "$1" ;;
  konsole-profile) gen_konsole_profile "$1" ;;
  iterm)           gen_iterm "$@" ;;
  itermcolors)     gen_itermcolors "$1" ;;
  *) echo "usage: theme-gen {tmux|konsole-scheme|konsole-profile|iterm|itermcolors} <name>..." >&2; exit 2 ;;
esac
