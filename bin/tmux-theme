#!/usr/bin/env bash
# Back-compat shim — `tmux-theme` is superseded by `theme` (which also drives the
# emulator, nvim, and zsh). Forwards all arguments. Old names map to new ones:
#   tmux-theme gruvbox    -> theme gruvbox-dark
#   tmux-theme tokyonight -> theme tokyonight
case "${1:-}" in
  gruvbox) set -- gruvbox-dark ;;
esac
exec theme "$@"
