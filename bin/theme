#!/usr/bin/env bash
# theme — switch terminal color scheme everywhere (emulator via OSC, tmux, nvim, zsh state).
# Usage:
#   theme                 pick interactively (fzf, else numbered menu)
#   theme <name>          switch to <name> (live)
#   theme list [--names]  list available themes (current marked)
#   theme next | prev     cycle
#   theme clear | 0       remove all forced overrides; revert to native colors
#   theme --reapply [name]  emit OSC for current (or given) theme only; no state write
#   theme --install-profiles  generate+install native Konsole/iTerm2 profiles
# Flags: --no-emulator (skip OSC), --quiet
set -u
BIN_DIR="$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")" && pwd)"
THEME_ROOT="${THEME_ROOT:-$(cd "$BIN_DIR/../themes" 2>/dev/null && pwd)}"
. "$THEME_ROOT/lib/palette.sh"
. "$THEME_ROOT/lib/osc.sh"
THEME_DEFAULT=gruvbox-dark
[ -r "$THEME_ROOT/theme.conf" ] && . "$THEME_ROOT/theme.conf"
THEME_STATE="${THEME_STATE:-$HOME/.config/theme/current}"
THEME_GEN="$BIN_DIR/theme-gen"

_current() { cat "$THEME_STATE" 2>/dev/null || echo "$THEME_DEFAULT"; }
_exists()  { [ -r "$(palette_path "$1")" ]; }
_say()     { [ -n "${QUIET:-}" ] || echo "$@"; }

_apply_emulator() {  # $1=name ; emits OSC unless --no-emulator
  [ -n "${NO_EMULATOR:-}" ] && return 0
  declare -A PAL=(); palette_load "$(palette_path "$1")" || return 1
  osc_string
}

_apply_tmux() {  # $1=name ; update running tmux server if present
  command -v tmux >/dev/null 2>&1 || return 0
  tmux info >/dev/null 2>&1 || return 0
  local conf="$HOME/.tmux/themes/$1.conf"
  mkdir -p "$HOME/.tmux/themes"
  "$THEME_GEN" tmux "$1" > "$conf" 2>/dev/null || return 0
  tmux source-file "$conf" 2>/dev/null
}

switch() {  # $1=name
  local n="$1"
  _exists "$n" || { echo "theme: unknown theme '$n' (try: theme list)" >&2; return 1; }
  _apply_emulator "$n"
  _apply_tmux "$n"
  mkdir -p "$(dirname "$THEME_STATE")"
  printf '%s\n' "$n" > "$THEME_STATE"   # nvim fs-watches this
  _say "theme: $n"
}

reapply() {  # $1=name (optional) — OSC only, no state write (zsh startup / root guard)
  local n="${1:-$(_current)}"
  _exists "$n" || return 1
  _apply_emulator "$n"
}

clear_theme() {  # remove ALL forced overrides: emulator palette, tmux, persisted state
  # 1. Emulator: revert to its own profile/native colors (unless --no-emulator).
  [ -n "${NO_EMULATOR:-}" ] || osc_reset
  # 2. tmux: unset every option the generated theme conf forces on the running
  #    server, so it falls back to the user's base config / built-in defaults.
  if command -v tmux >/dev/null 2>&1 && tmux info >/dev/null 2>&1; then
    local o
    for o in status-style status-left-style status-right-style \
             window-status-current-style window-status-style \
             pane-active-border-style pane-border-style \
             message-style mode-style window-style window-active-style; do
      tmux set -gu "$o" 2>/dev/null
    done
  fi
  # 3. Persist a non-theme sentinel so new shells (zsh `--reapply`) don't re-force
  #    a theme: 'none' is not a palette, so reapply()/_exists() no-op on it, and
  #    nvim's fs-watch finds no matching scheme and leaves the editor as-is.
  mkdir -p "$(dirname "$THEME_STATE")"
  printf 'none\n' > "$THEME_STATE"   # nvim fs-watches this
  _say "theme: cleared — overrides removed; new shells keep the terminal's native colors"
}

list() {
  local cur n; cur="$(_current)"
  if [ "${1:-}" = "--names" ]; then palette_list; return; fi
  while IFS= read -r n; do
    if [ "$n" = "$cur" ]; then printf '* %s\n' "$n"; else printf '  %s\n' "$n"; fi
  done < <(palette_list)
}

cycle() {  # $1=next|prev
  local cur names i idx cnt
  cur="$(_current)"; mapfile -t names < <(palette_list)
  cnt=${#names[@]}; [ "$cnt" -eq 0 ] && return 1
  idx=0; for i in "${!names[@]}"; do [ "${names[$i]}" = "$cur" ] && idx=$i; done
  if [ "$1" = "next" ]; then idx=$(( (idx+1) % cnt )); else idx=$(( (idx-1+cnt) % cnt )); fi
  switch "${names[$idx]}"
}

pick() {
  local n
  if command -v fzf >/dev/null 2>&1; then
    n="$(palette_list | fzf --prompt='theme> ' --height=40% --reverse)" || return 0
  else
    local names; mapfile -t names < <(palette_list)
    PS3="theme> "; select n in "${names[@]}"; do [ -n "$n" ] && break; done
  fi
  [ -n "$n" ] && switch "$n"
}

install_profiles() {
  local n
  case "$(uname -s)" in
    Linux)
      local kd="$HOME/.local/share/konsole"; mkdir -p "$kd"
      while IFS= read -r n; do
        "$THEME_GEN" konsole-scheme "$n"  > "$kd/$n.colorscheme"
        "$THEME_GEN" konsole-profile "$n" > "$kd/Theme $n.profile"
      done < <(palette_list)
      _say "installed Konsole schemes+profiles → $kd" ;;
    Darwin)
      local dp="$HOME/Library/Application Support/iTerm2/DynamicProfiles"; mkdir -p "$dp"
      rm -f "$dp/readest-themes.json"   # retire the old mis-named bundle
      # Write atomically. iTerm2 watches this directory and rejects ("invalid
      # JSON … not in the correct format") any file it reads mid-write — and a
      # plain '> file' redirect truncates then streams, so the watcher can catch
      # it empty/partial. Build in a temp on the same filesystem but OUTSIDE the
      # watched dir (no .json suffix so iTerm never parses it), then rename into
      # place: rename(2) is atomic, so iTerm only ever sees the complete file.
      local tmp; tmp="$(mktemp "${dp%/*}/terminal-themes.XXXXXX")"
      # shellcheck disable=SC2046
      if "$THEME_GEN" iterm $(palette_list | tr '\n' ' ') > "$tmp"; then
        mv -f "$tmp" "$dp/terminal-themes.json"
        _say "installed iTerm2 dynamic profiles → $dp/terminal-themes.json"
      else
        rm -f "$tmp"; echo "theme: failed to generate iTerm2 profiles" >&2; exit 1
      fi ;;
  esac
  # committed copies for sharing / manual import
  mkdir -p "$THEME_ROOT/generated"
  while IFS= read -r n; do "$THEME_GEN" itermcolors "$n" > "$THEME_ROOT/generated/$n.itermcolors"; done < <(palette_list)
}

# ---- arg parse ----
NO_EMULATOR=""; QUIET=""; pos=()
while [ $# -gt 0 ]; do
  case "$1" in
    --no-emulator) NO_EMULATOR=1 ;;
    --quiet) QUIET=1 ;;
    --reapply) shift; reapply "${1:-}"; exit $? ;;
    --install-profiles) install_profiles; exit $? ;;
    list) shift; list "${1:-}"; exit $? ;;
    next|prev) cycle "$1"; exit $? ;;
    clear|0) clear_theme; exit $? ;;
    -*) echo "theme: unknown flag $1" >&2; exit 2 ;;
    *) pos+=("$1") ;;
  esac
  shift
done

if [ "${#pos[@]}" -eq 0 ]; then pick; else switch "${pos[0]}"; fi
