#!/bin/bash
# dotfiles-update: clone or update the dotfiles repo and install files to $HOME.

set -euo pipefail

DOTFILES_DIR="$HOME/git/dotfiles"
DOTFILES_REPO="https://github.com/agiacalone/dotfiles.git"
PROGNAME="${0##*/}"

verbose=0

usage() {
    cat <<EOF
Usage: $PROGNAME [-v] [-h]

Clone or update the dotfiles repo and install files to \$HOME.

  -v, --verbose   show each file as it is copied
  -h, --help      display this help and exit
EOF
}

while [[ $# -gt 0 ]]; do
    case $1 in
        -v|--verbose) verbose=1 ;;
        -h|--help)    usage; exit 0 ;;
        --)           shift; break ;;
        -*)           echo "$PROGNAME: unknown option: $1" >&2; exit 2 ;;
        *)            break ;;
    esac
    shift
done

cp_flags=(-R)
(( verbose )) && cp_flags=(-Rv)

mkdir -p "$HOME/git"

if [[ ! -d "$DOTFILES_DIR/.git" ]]; then
    echo "cloning dotfiles repo..." >&2
    git clone "$DOTFILES_REPO" "$DOTFILES_DIR"
else
    echo "pulling latest changes..." >&2
    git -C "$DOTFILES_DIR" pull
fi

echo "copying dotfiles to $HOME..." >&2

shopt -s nullglob

# dot files, excluding .git and .github
for item in "$DOTFILES_DIR"/.[^.]*; do
    name="${item##*/}"
    [[ "$name" == ".git" || "$name" == ".github" ]] && continue
    cp "${cp_flags[@]}" "$item" "$HOME"/
done

# non-dot files, excluding CLAUDE.md
for item in "$DOTFILES_DIR"/*; do
    name="${item##*/}"
    [[ "$name" == "CLAUDE.md" ]] && continue
    cp "${cp_flags[@]}" "$item" "$HOME"/
done

# regenerate native terminal-theme profiles (Konsole / iTerm2) from the palettes.
# best-effort: never fail the update if the theme tool or its deps are missing.
if [[ -x "$HOME/bin/theme" ]]; then
    echo "installing terminal theme profiles..." >&2
    "$HOME/bin/theme" --quiet --install-profiles || true
fi

echo "fixing permissions..." >&2

# ~/.ssh — SSH is strict: wrong perms cause silent auth failures
if [[ -d "$HOME/.ssh" ]]; then
    chmod 700 "$HOME/.ssh"
    [[ -f "$HOME/.ssh/config" ]]          && chmod 600 "$HOME/.ssh/config"
    [[ -f "$HOME/.ssh/authorized_keys" ]] && chmod 600 "$HOME/.ssh/authorized_keys"
    [[ -f "$HOME/.ssh/known_hosts" ]]     && chmod 644 "$HOME/.ssh/known_hosts"
    for f in "$HOME/.ssh/"*; do
        [[ -f "$f" ]] || continue
        case "$f" in
            *.pub) chmod 644 "$f" ;;
            *)     chmod 600 "$f" ;;
        esac
    done
fi

# ~/.gnupg — GPG refuses to use keys if perms are too open
if [[ -d "$HOME/.gnupg" ]]; then
    chmod 700 "$HOME/.gnupg"
    find "$HOME/.gnupg" -type f -exec chmod 600 {} +
    find "$HOME/.gnupg" -type d -exec chmod 700 {} +
fi

# On a GRAPHICAL box, a zsh login shell black-screens the desktop on the next reboot: the
# session launcher runs the login shell with no controlling terminal and zsh's p10k instant
# prompt blocks it, so the desktop never starts. The tracked .zshrc now guards against that,
# but the login shell is user state this script does not own — and one hand-run `chsh` has
# already cost an evening. Warn, every update, until it's put back.
login_shell="$(getent passwd "$(id -un)" 2>/dev/null | cut -d: -f7)"
if [[ "${login_shell##*/}" == "zsh" ]] && systemctl get-default 2>/dev/null | grep -q graphical; then
    cat >&2 <<EOF

  !! WARNING: your LOGIN shell is zsh on a graphical machine.
     This has caused a permanent black screen over RDP after reboot. Put it back:

         sudo chsh -s /bin/bash $(id -un)

     You lose nothing: .bashrc execs zsh for every interactive terminal.

EOF
fi

echo "done." >&2
