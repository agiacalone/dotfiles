#!/bin/bash

# dotfiles-update: clones or updates the dotfiles repo and copies files to $HOME.

DOTFILES_DIR="$HOME/git/dotfiles"
DOTFILES_REPO="https://github.com/agiacalone/dotfiles.git"

mkdir -p "$HOME/git"

if [[ ! -d "$DOTFILES_DIR/.git" ]]; then
    echo "Cloning dotfiles repo..."
    git clone "$DOTFILES_REPO" "$DOTFILES_DIR" || { echo "Error: git clone failed" >&2; exit 1; }
else
    echo "Pulling latest changes..."
    git -C "$DOTFILES_DIR" pull || { echo "Error: git pull failed" >&2; exit 1; }
fi

echo "Copying dotfiles to $HOME..."
# Copy dot files, excluding .git and .github
for item in "$DOTFILES_DIR"/.[^.]*; do
    name=$(basename "$item")
    [[ "$name" == ".git" || "$name" == ".github" ]] && continue
    cp -Rv "$item" "$HOME"/
done
# Copy non-dot files, excluding CLAUDE.md
for item in "$DOTFILES_DIR"/*; do
    name=$(basename "$item")
    [[ "$name" == "CLAUDE.md" ]] && continue
    cp -Rv "$item" "$HOME"/
done

echo "Fixing permissions..."

# ~/.ssh — SSH is strict: wrong perms cause silent auth failures
if [[ -d "$HOME/.ssh" ]]; then
    chmod 700 "$HOME/.ssh"
    chmod 600 "$HOME/.ssh/config" 2>/dev/null
    chmod 600 "$HOME/.ssh/authorized_keys" 2>/dev/null
    chmod 644 "$HOME/.ssh/known_hosts" 2>/dev/null
    # Private keys: no extension or ending in _key; public keys: .pub
    for f in "$HOME/.ssh/"*; do
        [[ -f "$f" ]] || continue
        case "$f" in
            *.pub)            chmod 644 "$f" ;;
            *.conf|*config)   chmod 600 "$f" ;;
            *)                chmod 600 "$f" ;;
        esac
    done
fi

# ~/.gnupg — GPG refuses to use keys if perms are too open
if [[ -d "$HOME/.gnupg" ]]; then
    chmod 700 "$HOME/.gnupg"
    find "$HOME/.gnupg" -type f -exec chmod 600 {} \;
    find "$HOME/.gnupg" -type d -exec chmod 700 {} \;
fi

echo "Done."
