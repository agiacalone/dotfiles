#!/bin/bash

# rm-ad: removes ad/garbage image files from within a comic book archive (CBZ/ZIP).
# Patterns are maintained in ~/bin/rm-ad-list, one per line.

if [[ -z "$1" ]]; then
    echo "Usage: rm-ad <archive.cbz>" >&2
    exit 1
fi

if [[ ! -f "$1" ]]; then
    echo "Error: file not found: $1" >&2
    exit 1
fi

chmod 774 "$1"
chown "$(id -un):$(id -gn)" "$1"

# Read patterns from list file, skip blank lines and comments
mapfile -t patterns < <(grep -v '^\s*#' ~/bin/rm-ad-list | grep -v '^\s*$')

if [[ ${#patterns[@]} -eq 0 ]]; then
    echo "Error: no patterns found in ~/bin/rm-ad-list" >&2
    exit 1
fi

zip -dq "$1" "${patterns[@]}"
